# Quarto copies these into the output dir; never publish or track them
_docs/renv/

# Cloud-sync conflict copies ("foo 2.html", "bar 3.csv", "baz 2/").
# This repo lives in a synced folder that creates these continuously.
# Verified: matches no .qmd source, only build artifacts and data duplicates.
# Any extension: the per-extension list missed .json, .css, .js and .txt, and
# two of those reached a commit. Single digit only -- "DOE Schools 2009.shp" is
# a real shapefile named for a year, and must NOT be ignored.
* [0-9].*
* [0-9]/

# API keys live in ~/.Renviron, never in the project
.Renviron
.Rprofile.local
